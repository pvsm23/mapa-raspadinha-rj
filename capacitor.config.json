{
  "appId": "io.github.pvsm23.desbrava",
  "appName": "Desbrava",
  "webDir": "www",
  "android": {
    "backgroundColor": "#000000"
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_desbrava",
      "iconColor": "#2BD576"
    },
    "SplashScreen": {
      "backgroundColor": "#000000",
      "showSpinner": false,
      "launchAutoHide": true
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": ["google.com"]
    }
  }
}
