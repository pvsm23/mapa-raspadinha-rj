{
  "appId": "io.github.pvsm23.desbrava",
  "appName": "Desbrava",
  "webDir": "www",
  "android": {
    "backgroundColor": "#000000"
  },
  "plugins": {
    "SplashScreen": {
      "backgroundColor": "#000000",
      "showSpinner": false,
      "launchAutoHide": true
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": ["google.com"]
    },
    "BackgroundRunner": {
      "label": "io.github.pvsm23.desbrava.geo",
      "src": "runners/geo-runner.js",
      "event": "checarLocalizacaoDesbrava",
      "repeat": true,
      "interval": 60,
      "autoStart": true
    }
  }
}
